{
	"name": "phrasecraft",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "biome check . && astro check && vitest run && node scripts/validate-wordlist.mjs",
