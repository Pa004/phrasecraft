		"sprite:build": "node scripts/build-sprite.mjs"
	},
	"dependencies": {
		"@astrojs/svelte": "^7.0.0",
		"astro": "^5.0.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@axe-core/playwright": "^4.9.0",
		"@biomejs/biome": "^1.9.0",
		"@fluentui-emoji/sprite": "^2.2.0",
		"@lhci/cli": "^0.14.0",
		"@pandacss/dev": "^0.5.0",
		"@playwright/test": "^1.49.0",
		"@vite-pwa/astro": "^1.0.0",
		"emojibase-data": "^17.0.0",
		"typescript": "^5.6.0",
		"vitest": "^3.0.0"
	}
