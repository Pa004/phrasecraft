---
interface Props {
	title: string;
	id?: string;
}

const { title, id } = Astro.props;
---

<section class="board" aria-label={title} id={id}>
	<div class="board-bar" aria-hidden="true">
		<span></span><span></span><span></span>
	</div>
	<h2 class="board-title">{title}</h2>
	<slot />
</section>

<style>
	.board {
		border: 3px solid var(--surface-border);
		border-radius: 1.5rem;
		background: var(--surface);
		box-shadow:
			inset 0 2px 0 rgb(255 255 255 / 0.1),
			var(--shadow-3);
		padding: 1.25rem;
		margin: 1.5rem 0;
	}
	.board-bar {
		display: flex;
		gap: 0.4rem;
		margin-bottom: 0.75rem;
	}
	.board-bar span {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--surface-border);
		box-shadow: inset 0 1px 2px rgb(26 26 46 / 0.3);
	}
	.board-bar span:first-child {
		background: var(--accent);
	}
	.board-title {
		margin-top: 0;
		font-size: 1.4rem;
	}
</style>
