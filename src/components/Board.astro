---
interface Props {
	title: string;
	id?: string;
	pill?: string;
}

const { title, id, pill } = Astro.props;
---

<section class="board" aria-label={title} id={id}>
	<div class="diorama-bar">
		<span class="luces" aria-hidden="true"><span></span><span></span><span></span></span>
		<h2 class="board-title">{title}</h2>
		{pill && <span class="pildora">{pill}</span>}
	</div>
	<div class="diorama-cuerpo">
		<slot />
	</div>
</section>

<style>
	.board {
		background: var(--surface);
		border: 5px solid var(--edge);
		border-radius: 16px;
		box-shadow: 12px 12px 0 var(--hard);
		position: relative;
		overflow: hidden;
		margin: 1.5rem 0;
		transform-style: preserve-3d;
		transition: transform 0.18s ease-out;
	}
	.diorama-bar {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 12px 20px;
		border-bottom: 3px solid var(--edge);
	}
	.luces {
		display: flex;
		gap: 8px;
	}
	.luces span {
		width: 14px;
		height: 14px;
		border-radius: 50%;
		border: 2.5px solid var(--edge);
		display: block;
		background: var(--surface);
	}
	.luces span:nth-child(1) {
		background: var(--accent);
	}
	.board-title {
		font-family: var(--font-display);
		margin: 0;
		font-size: 1.2rem;
		letter-spacing: -0.01em;
	}
	.pildora {
		margin-left: auto;
		font-size: 0.8rem;
		font-weight: 800;
		background: var(--accent);
		color: var(--btn-ink);
		border: 2.5px solid var(--edge);
		border-radius: 999px;
		padding: 6px 14px;
	}
	.diorama-cuerpo {
		padding: 24px;
		display: grid;
		gap: 16px;
	}
	@media (max-width: 720px) {
		.diorama-cuerpo {
			padding: 16px;
		}
	}
</style>
