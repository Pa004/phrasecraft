---
interface Props {
	current: string;
}

const { current } = Astro.props;
const links = [
	{ href: "/", label: "Generar" },
	{ href: "/practicar", label: "Practicar" },
	{ href: "/seguridad", label: "Seguridad" },
	{ href: "/estudio", label: "Estudio" },
];
---

<div class="topbar">
	<a class="brand" href="/" aria-label="phrasecraft: inicio">
		<img src="/favicon.svg" alt="" width="32" height="32" aria-hidden="true" />
		<span class="brand-text">phrasecraft<small>RECUERDA · PROTEGE</small></span>
	</a>
	<nav aria-label="Principal">
		{links.map((l) =>
			l.href === current ? (
				<span class="nav-chip current" aria-current="page">{l.label}</span>
			) : (
				<a class="nav-chip" href={l.href}>{l.label}</a>
			),
		)}
	</nav>
</div>

<style>
	.topbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.75rem 1rem;
		margin-bottom: 1rem;
		background: var(--surface);
		border: 3px solid var(--edge);
		border-radius: 20px;
		box-shadow: 5px 5px 0 var(--hard);
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: var(--ink);
	}
	.brand-text {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.25rem;
		display: grid;
		line-height: 1;
	}
	.brand-text small {
		font-family: var(--font-body);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		color: var(--accent-dark);
	}
	@media (prefers-color-scheme: dark) {
		.brand-text small {
			color: var(--accent);
		}
	}
	.topbar nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.nav-chip.current {
		background: var(--accent);
		border-color: var(--edge);
		color: var(--btn-ink);
	}
</style>
