---
interface NavLink {
	href: string;
	label: string;
}

interface Props {
	current?: string;
	links?: NavLink[];
	ctaHref?: string;
	ctaLabel?: string;
}

const {
	current = "",
	links = [
		{ href: "/", label: "Generar" },
		{ href: "/practicar", label: "Practicar" },
		{ href: "/seguridad", label: "Seguridad" },
		{ href: "/estudio", label: "Estudio" },
	],
	ctaHref,
	ctaLabel,
} = Astro.props;
---

<div class="topbar">
	<a class="brand" href="/" aria-label="phrasecraft: inicio">
		<span class="brand-mark" aria-hidden="true">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="4" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /><circle cx="12" cy="15" r="1.6" fill="currentColor" /></svg>
		</span>
		<span class="brand-text">phrasecraft<small>RECUERDA · PROTEGE</small></span>
	</a>
	<nav aria-label="Principal">
		{links.map((l) =>
			l.href === current ? (
				<span class="navlink current" aria-current="page">{l.label}</span>
			) : (
				<a class="navlink" href={l.href}>{l.label}</a>
			),
		)}
		{ctaHref && ctaLabel && (
			<a class="btn-3d nav-cta" href={ctaHref}>{ctaLabel}</a>
		)}
	</nav>
</div>

<style>
	.topbar {
		position: sticky;
		top: 12px;
		z-index: 20;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
		padding: 8px 12px;
		margin-top: 16px;
		margin-bottom: 0.5rem;
		background: var(--surface);
		border: 3px solid var(--edge);
		border-radius: 16px;
		box-shadow: 4px 4px 0 var(--hard);
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		text-decoration: none;
		color: var(--ink);
		min-height: 44px;
	}
	.brand-mark {
		width: 44px;
		height: 44px;
		border-radius: 16px;
		background: var(--accent);
		border: 3px solid var(--edge);
		display: grid;
		place-items: center;
		box-shadow: 2px 2px 0 var(--hard);
		flex: none;
		color: var(--btn-ink);
	}
	.brand-mark svg {
		width: 24px;
		height: 24px;
	}
	.brand-text {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.25rem;
		display: block;
		line-height: 1.05;
		letter-spacing: -0.02em;
	}
	.brand-text small {
		display: block;
		font-family: var(--font-body);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		opacity: 0.75;
	}
	.topbar nav {
		margin-left: auto;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
	}
	.navlink {
		text-decoration: none;
		font-weight: 700;
		font-size: 0.92rem;
		padding: 10px 12px;
		border-radius: 16px;
		min-height: 44px;
		display: inline-flex;
		align-items: center;
		color: var(--ink);
	}
	.navlink:hover {
		background: var(--surface-2);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.navlink:focus-visible {
		outline: 4px solid var(--accent-dark);
		outline-offset: 2px;
	}
	.navlink.current {
		background: var(--accent);
		color: var(--btn-ink);
		border: 3px solid var(--edge);
		padding: 7px 9px;
	}
	.nav-cta {
		font-size: 0.94rem;
		min-height: 44px;
		padding: 10px 16px;
	}
</style>
