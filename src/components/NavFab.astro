---
interface NavLink {
	href: string;
	label: string;
	desc?: string;
}

interface Props {
	current?: string;
	sections?: NavLink[];
}

const { current = "", sections = [] } = Astro.props;

const links: NavLink[] = [
	{ href: "/", label: "Generar", desc: "Crea tu contraseña maestra" },
	{
		href: "/practicar",
		label: "Practicar",
		desc: "5 etapas guiadas en minutos",
	},
	{
		href: "/estudio",
		label: "Estudio",
		desc: "Desechable, recuerdo y exporte",
	},
];
---

<div class="sitehead" data-nav-fab>
	<div class="sitehead-row">
		<button
			type="button"
			class="fab-toggle"
			aria-expanded="false"
			aria-haspopup="true"
			aria-controls="fab-menu"
			aria-label="Abrir menú de navegación"
		>
			<span class="burg" aria-hidden="true"><span></span><span></span><span></span></span>
		</button>
		<a class="brand" href="/" aria-label="phrasecraft: inicio">
			<span class="brand-mark" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="4" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /><circle cx="12" cy="15" r="1.6" fill="currentColor" /></svg>
			</span>
			<span class="brand-text">phrasecraft<small>OLVIDA OLVIDAR</small></span>
		</a>
	</div>
	<nav id="fab-menu" class="fab-menu" aria-label="Navegación" hidden>
		{sections.length > 0 && (
			<div class="fab-col">
				<p class="fab-group" id="fab-grupo-pagina">En esta página</p>
				<ul class="fab-list" aria-labelledby="fab-grupo-pagina">
					{sections.map((s) => (
						<li>
							<a class="fab-link" href={s.href}>
								<span class="fab-title">{s.label}</span>
								{s.desc && <small class="fab-desc">{s.desc}</small>}
							</a>
						</li>
					))}
				</ul>
			</div>
		)}
		<div class="fab-col">
			<p class="fab-group" id="fab-grupo-sitio">Páginas</p>
			<ul class="fab-list" aria-labelledby="fab-grupo-sitio">
				{links.map((l) => (
					<li>
						<a
							class="fab-link"
							class:list={[{ current: l.href === current }]}
							href={l.href}
							aria-current={l.href === current ? "page" : undefined}
						>
							<span class="fab-title">{l.label}</span>
							{l.desc && <small class="fab-desc">{l.desc}</small>}
						</a>
					</li>
				))}
			</ul>
		</div>
	</nav>
</div>

<script>
	document.querySelectorAll<HTMLDivElement>("[data-nav-fab]").forEach((fab) => {
		const btn = fab.querySelector<HTMLButtonElement>("button.fab-toggle");
		const menu = fab.querySelector<HTMLElement>(".fab-menu");
		if (!btn || !menu) return;

		let expanded = false;

		const close = () => {
			expanded = false;
			fab.classList.remove("is-open");
			btn.setAttribute("aria-expanded", "false");
			btn.setAttribute("aria-label", "Abrir menú de navegación");
			menu.hidden = true;
		};

		const open = () => {
			expanded = true;
			fab.classList.add("is-open");
			btn.setAttribute("aria-expanded", "true");
			btn.setAttribute("aria-label", "Cerrar menú de navegación");
			menu.hidden = false;
		};

		btn.addEventListener("click", () => (expanded ? close() : open()));

		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && expanded) {
				close();
				if (e.target instanceof Node && fab.contains(e.target)) btn.focus();
			}
		});

		document.addEventListener("pointerdown", (e) => {
			if (e.target instanceof Node && !fab.contains(e.target)) close();
		});

		menu.addEventListener("click", (e) => {
			if (e.target instanceof Element && e.target.closest("a")) close();
		});
	});
</script>

<style>
	.sitehead {
		position: sticky;
		top: 12px;
		z-index: 40;
		max-width: 1080px;
		margin: 16px auto 0.5rem;
		background: var(--surface);
		border: 3px solid var(--edge);
		border-radius: 16px;
		box-shadow: 4px 4px 0 var(--hard);
		padding: 8px 12px;
	}
	.sitehead-row {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.fab-toggle {
		width: 56px;
		height: 56px;
		border-radius: 18px;
		background: var(--surface);
		border: 3px solid var(--edge);
		box-shadow: 4px 4px 0 var(--hard);
		display: grid;
		place-items: center;
		cursor: pointer;
		color: var(--ink);
		flex: none;
		transition: transform 0.08s ease-out, box-shadow 0.08s ease-out,
			background 0.15s ease;
	}
	.fab-toggle:hover {
		background: var(--surface-2);
	}
	.fab-toggle:active {
		transform: translate(3px, 3px);
		box-shadow: 1px 1px 0 var(--hard);
	}
	.fab-toggle:focus-visible {
		outline: 4px solid var(--accent-dark);
		outline-offset: 3px;
	}
	.burg {
		display: grid;
		gap: 5px;
	}
	.burg span {
		width: 24px;
		height: 3.5px;
		border-radius: 2px;
		background: var(--ink);
		display: block;
	}
	@media (prefers-reduced-motion: no-preference) {
		.burg span {
			transition: transform 0.2s ease-out, opacity 0.15s ease-out;
		}
	}
	.is-open .burg span:nth-child(1) {
		transform: translateY(8.5px) rotate(45deg);
	}
	.is-open .burg span:nth-child(2) {
		opacity: 0;
	}
	.is-open .burg span:nth-child(3) {
		transform: translateY(-8.5px) rotate(-45deg);
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		text-decoration: none;
		color: var(--ink);
		min-height: 44px;
	}
	.brand-mark {
		width: 44px;
		height: 44px;
		border-radius: 16px;
		background: var(--accent);
		border: 3px solid var(--edge);
		display: grid;
		place-items: center;
		box-shadow: 2px 2px 0 var(--hard);
		flex: none;
		color: var(--btn-ink);
	}
	.brand-mark svg {
		width: 24px;
		height: 24px;
	}
	.brand-text {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.25rem;
		display: block;
		line-height: 1.05;
		letter-spacing: -0.02em;
	}
	.brand-text small {
		display: block;
		font-family: var(--font-body);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		opacity: 0.75;
		margin-top: 4px;
	}
	.fab-menu[hidden] {
		display: none;
	}
	.fab-menu {
		position: absolute;
		top: calc(100% + 8px);
		left: 0;
		right: 0;
		display: grid;
		gap: 4px 24px;
		padding: 10px 12px 14px;
		background: var(--surface);
		background: color-mix(in srgb, var(--surface) 65%, transparent);
		-webkit-backdrop-filter: blur(18px) saturate(1.3);
		backdrop-filter: blur(18px) saturate(1.3);
		border: 3px solid var(--edge);
		border-radius: 16px;
		box-shadow: inset 0 2px 0 rgb(255 255 255 / 0.35), 6px 6px 0 var(--hard);
		max-height: 60vh;
		overflow-y: auto;
		overscroll-behavior: contain;
	}
	@media (min-width: 720px) {
		.fab-menu {
			grid-template-columns: 1fr 1fr;
		}
	}
	.fab-group {
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.7;
		margin: 10px 12px 2px;
	}
	.fab-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}
	.fab-link {
		display: block;
		padding: 10px 12px;
		border-radius: 12px;
		text-decoration: none;
		color: var(--ink);
	}
	.fab-title {
		display: block;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.02rem;
		line-height: 1.25;
	}
	.fab-desc {
		display: block;
		font-size: 0.82rem;
		opacity: 0.75;
		margin-top: 2px;
	}
	.fab-link:hover .fab-title {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.fab-link:focus-visible {
		outline: 4px solid var(--accent-dark);
		outline-offset: 2px;
	}
	.fab-link.current .fab-title {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
