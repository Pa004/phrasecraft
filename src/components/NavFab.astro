---
interface NavLink {
	href: string;
	label: string;
	desc?: string;
}

interface Props {
	current?: string;
	sections?: NavLink[];
}

const { current = "", sections = [] } = Astro.props;

const links: NavLink[] = [
	{ href: "/", label: "Generar", desc: "Crea tu contraseña maestra" },
	{
		href: "/practicar",
		label: "Practicar",
		desc: "5 etapas guiadas en minutos",
	},
	{ href: "/seguridad", label: "Seguridad", desc: "Qué se defiende y qué no" },
	{
		href: "/estudio",
		label: "Estudio",
		desc: "Desechable, recuerdo y exporte",
	},
];
---

<div class="fab" data-nav-fab>
	<button
		type="button"
		class="fab-toggle"
		aria-expanded="false"
		aria-haspopup="true"
		aria-controls="fab-menu"
		aria-label="Abrir menú de navegación"
	>
		<span class="burg" aria-hidden="true"><span></span><span></span><span></span></span>
	</button>
	<nav id="fab-menu" class="fab-menu" aria-label="Navegación" hidden>
		{sections.length > 0 && (
			<>
				<p class="fab-group" id="fab-grupo-pagina">En esta página</p>
				<ul class="fab-list" aria-labelledby="fab-grupo-pagina">
					{sections.map((s) => (
						<li>
							<a class="fab-link" href={s.href}>
								<span class="fab-title">{s.label}</span>
								{s.desc && <small class="fab-desc">{s.desc}</small>}
							</a>
						</li>
					))}
				</ul>
			</>
		)}
		<p class="fab-group" id="fab-grupo-sitio">Páginas</p>
		<ul class="fab-list" aria-labelledby="fab-grupo-sitio">
			{links.map((l) => (
				<li>
					<a
						class="fab-link"
						class:list={[{ current: l.href === current }]}
						href={l.href}
						aria-current={l.href === current ? "page" : undefined}
					>
						<span class="fab-title">{l.label}</span>
						{l.desc && <small class="fab-desc">{l.desc}</small>}
					</a>
				</li>
			))}
		</ul>
	</nav>
</div>

<script>
	document.querySelectorAll<HTMLDivElement>("[data-nav-fab]").forEach((fab) => {
		const btn = fab.querySelector<HTMLButtonElement>("button.fab-toggle");
		const menu = fab.querySelector<HTMLElement>(".fab-menu");
		if (!btn || !menu) return;

		let expanded = false;

		const close = () => {
			expanded = false;
			fab.classList.remove("is-open");
			btn.setAttribute("aria-expanded", "false");
			btn.setAttribute("aria-label", "Abrir menú de navegación");
			menu.hidden = true;
		};

		const open = () => {
			expanded = true;
			fab.classList.add("is-open");
			btn.setAttribute("aria-expanded", "true");
			btn.setAttribute("aria-label", "Cerrar menú de navegación");
			menu.hidden = false;
		};

		const syncTop = () => {
			const bar = document.querySelector<HTMLElement>(".topbar");
			const y = bar ? bar.getBoundingClientRect().bottom + 10 : 84;
			fab.style.setProperty("--fab-top", `${Math.round(y)}px`);
		};

		btn.addEventListener("click", () => (expanded ? close() : open()));

		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && expanded) {
				close();
				if (e.target instanceof Node && fab.contains(e.target)) btn.focus();
			}
		});

		document.addEventListener("pointerdown", (e) => {
			if (e.target instanceof Node && !fab.contains(e.target)) close();
		});

		menu.addEventListener("click", (e) => {
			if (e.target instanceof Element && e.target.closest("a")) close();
		});

		syncTop();
		fab.classList.add("is-ready");
		window.addEventListener("resize", syncTop);
	});
</script>

<style>
	.fab {
		position: fixed;
		left: 12px;
		top: var(--fab-top, 84px);
		z-index: 40;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 10px;
		visibility: hidden;
	}
	.fab.is-ready {
		visibility: visible;
	}
	.fab-toggle {
		width: 56px;
		height: 56px;
		border-radius: 18px;
		background: var(--surface);
		border: 3px solid var(--edge);
		box-shadow: 4px 4px 0 var(--hard);
		display: grid;
		place-items: center;
		cursor: pointer;
		color: var(--ink);
		transition: transform 0.08s ease-out, box-shadow 0.08s ease-out,
			background 0.15s ease;
	}
	.fab-toggle:hover {
		background: var(--surface-2);
	}
	.fab-toggle:active {
		transform: translate(3px, 3px);
		box-shadow: 1px 1px 0 var(--hard);
	}
	.fab-toggle:focus-visible {
		outline: 4px solid var(--accent-dark);
		outline-offset: 3px;
	}
	.burg {
		display: grid;
		gap: 5px;
	}
	.burg span {
		width: 24px;
		height: 3.5px;
		border-radius: 2px;
		background: var(--ink);
		display: block;
	}
	@media (prefers-reduced-motion: no-preference) {
		.burg span {
			transition: transform 0.2s ease-out, opacity 0.15s ease-out;
		}
	}
	.is-open .burg span:nth-child(1) {
		transform: translateY(8.5px) rotate(45deg);
	}
	.is-open .burg span:nth-child(2) {
		opacity: 0;
	}
	.is-open .burg span:nth-child(3) {
		transform: translateY(-8.5px) rotate(-45deg);
	}
	.fab-menu[hidden] {
		display: none;
	}
	.fab-menu {
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border: 3px solid var(--edge);
		border-radius: 16px;
		box-shadow: 6px 6px 0 var(--hard);
		padding: 6px 6px 10px;
		min-width: 248px;
		max-width: 300px;
		max-height: calc(100vh - var(--fab-top, 84px) - 90px);
		overflow-y: auto;
		overscroll-behavior: contain;
	}
	.fab-group {
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.7;
		margin: 10px 12px 2px;
	}
	.fab-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}
	.fab-link {
		display: block;
		padding: 10px 12px;
		border-radius: 12px;
		text-decoration: none;
		color: var(--ink);
	}
	.fab-title {
		display: block;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.02rem;
		line-height: 1.25;
	}
	.fab-desc {
		display: block;
		font-size: 0.82rem;
		opacity: 0.75;
		margin-top: 2px;
	}
	.fab-link:hover .fab-title {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.fab-link:focus-visible {
		outline: 4px solid var(--accent-dark);
		outline-offset: 2px;
	}
	.fab-link.current .fab-title {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
