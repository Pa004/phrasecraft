---
interface Props {
	title: string;
	text: string;
	span?: boolean;
}

const { title, text, span = false } = Astro.props;
---

<li class:list={["cell", { wide: span }]}>
	<strong>{title}</strong>
	<span>{text}</span>
</li>

<style>
	.cell {
		display: grid;
		gap: 0.35rem;
		align-content: start;
		padding: 1rem;
		border-radius: 1.25rem;
		border: 2px solid var(--surface-border);
		background: var(--surface);
		box-shadow: var(--shadow-1);
		list-style: none;
	}
	.cell strong {
		font-size: 1.05rem;
	}
	.cell span {
		font-size: 0.95rem;
		line-height: 1.55;
	}
</style>
