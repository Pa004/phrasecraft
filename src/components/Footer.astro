<style>
	.pie {
		margin: 24px 0 40px;
		background: var(--edge);
		color: var(--paper);
		border: 3px solid var(--edge);
		border-radius: 16px;
		box-shadow: 4px 4px 0 var(--hard);
		padding: 20px 24px;
		display: flex;
		gap: 12px;
		align-items: center;
		flex-wrap: wrap;
	}
	.pie p {
		margin: 0;
		font-size: 0.92rem;
		flex: 1 1 220px;
	}
	.pie strong {
		font-family: var(--font-display);
	}
	.pie nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.pie .nav-chip {
		border-color: var(--paper);
	}
	.brand-mark {
		width: 40px;
		height: 40px;
		border-radius: 16px;
		background: var(--accent);
		border: 3px solid var(--paper);
		display: grid;
		place-items: center;
		flex: none;
		color: var(--btn-ink);
	}
	.brand-mark svg {
		width: 24px;
		height: 24px;
	}
</style>
