---
interface Props {
	n: string;
	title: string;
	text: string;
}

const { n, title, text } = Astro.props;
---

<li class="step">
	<span class="step-n" aria-hidden="true">{n}</span>
	<strong>{title}</strong>
	<span>{text}</span>
</li>

<style>
	.step {
		background: var(--surface);
		border: 3px solid var(--edge);
		border-radius: 16px;
		box-shadow: 4px 4px 0 var(--hard);
		padding: 20px;
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 8px;
		list-style: none;
	}
	.step:nth-child(2) {
		transform: translateY(8px);
	}
	.step:nth-child(3) {
		transform: translateY(16px);
	}
	@media (max-width: 720px) {
		.step:nth-child(2),
		.step:nth-child(3) {
			transform: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.step:nth-child(2),
		.step:nth-child(3) {
			transform: none;
		}
	}
	.step-n {
		width: 44px;
		height: 44px;
		border-radius: 16px;
		border: 3px solid var(--edge);
		background: var(--accent);
		color: var(--btn-ink);
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.3rem;
		display: grid;
		place-items: center;
		box-shadow: 2px 2px 0 var(--hard);
	}
	.step strong {
		font-family: var(--font-display);
		font-size: 1.12rem;
	}
	.step span:last-child {
		opacity: 0.85;
		font-size: 0.95rem;
	}
</style>
