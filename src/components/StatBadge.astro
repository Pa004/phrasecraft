---
interface Props {
	value: string;
	label: string;
}

const { value, label } = Astro.props;
---

<li class="stat">
	<strong>{value}</strong>
	<span>{label}</span>
</li>

<style>
	.stat {
		display: grid;
		gap: 0.1rem;
		background: var(--surface);
		border: 3px solid var(--edge);
		border-radius: 16px;
		box-shadow: 4px 4px 0 var(--hard);
		padding: 12px 16px;
		min-width: 160px;
		flex: 1 1 160px;
		max-width: 240px;
		list-style: none;
	}
	.stat strong {
		font-family: var(--font-display);
		font-size: 1.45rem;
		display: block;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}
	.stat span {
		font-weight: 700;
		font-size: 0.8rem;
		opacity: 0.75;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
</style>
