---
interface Props {
	badge: string;
	title: string;
	sub: string;
	ctaHref?: string;
	ctaLabel?: string;
	cta2Href?: string;
	cta2Label?: string;
	marks?: string[];
}

const {
	badge,
	title,
	sub,
	ctaHref,
	ctaLabel,
	cta2Href,
	cta2Label,
	marks = [],
} = Astro.props;

function marked(text: string): { hit: boolean; text: string }[] {
	let parts: { hit: boolean; text: string }[] = [{ hit: false, text }];
	for (const m of marks) {
		parts = parts.flatMap((p) => {
			if (p.hit || !p.text.includes(m)) return [p];
			const [head, ...tail] = p.text.split(m);
			const out: { hit: boolean; text: string }[] = [];
			if (head) out.push({ hit: false, text: head });
			tail.forEach((t, i) => {
				out.push({ hit: true, text: m });
				if (t || i < tail.length - 1) out.push({ hit: false, text: t });
			});
			return out;
		});
	}
	return parts.filter((p) => p.text.length > 0);
}
---

<div class="hero">
	<p class="hero-badge"><span class="dot" aria-hidden="true"><i></i></span>{badge}</p>
	<h1 class="title-3d hero-display">
		{marked(title).map((p) =>
			p.hit ? <span class="marker">{p.text}</span> : p.text,
		)}
	</h1>
	<p class="hero-sub">
		{marked(sub).map((p) =>
			p.hit ? <span class="marker">{p.text}</span> : p.text,
		)}
	</p>
	<slot name="stats" />
	{(ctaHref && ctaLabel) || (cta2Href && cta2Label) ? (
		<p class="hero-ctas">
			{ctaHref && ctaLabel && (
				<a class="btn-3d hero-cta" href={ctaHref}>{ctaLabel}</a>
			)}
			{cta2Href && cta2Label && (
				<a class="btn-3d-secondary hero-cta" href={cta2Href}>{cta2Label}</a>
			)}
		</p>
	) : null}
	<slot />
</div>

<style>
	.hero {
		padding: 2.5rem 0 1.5rem;
		max-width: 44rem;
	}
	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: 0.84rem;
		font-weight: 700;
		padding: 8px 16px 8px 10px;
		border-radius: 999px;
		border: 3px solid var(--edge);
		background: var(--surface);
		box-shadow: 4px 4px 0 var(--hard);
	}
	.dot {
		width: 24px;
		height: 24px;
		border-radius: 50%;
		background: var(--accent);
		border: 2px solid var(--edge);
		flex: none;
		display: grid;
		place-items: center;
	}
	.dot i {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--edge);
		display: block;
	}
	.hero-sub {
		font-size: 1.14rem;
		font-weight: 500;
		line-height: 1.6;
		max-width: 56ch;
		margin: 0 0 20px;
		opacity: 0.85;
	}
	.hero-display {
		font-size: clamp(2.5rem, 5.4vw, 3.9rem);
		line-height: 1;
		letter-spacing: -0.03em;
		margin: 16px 0 12px;
		max-width: 20ch;
		text-wrap: balance;
	}
	.hero-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.hero-cta {
		display: inline-block;
		text-decoration: none;
		font-size: 1.15rem;
	}
</style>
