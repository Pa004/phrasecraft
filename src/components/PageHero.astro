---
interface Props {
	badge: string;
	title: string;
	sub: string;
	ctaHref?: string;
	ctaLabel?: string;
	cta2Href?: string;
	cta2Label?: string;
}

const { badge, title, sub, ctaHref, ctaLabel, cta2Href, cta2Label } =
	Astro.props;
---

<div class="hero">
	<p class="hero-badge">{badge}</p>
	<h1 class="title-3d">{title}</h1>
	<p class="hero-sub">{sub}</p>
	<slot name="stats" />
	{(ctaHref && ctaLabel) || (cta2Href && cta2Label) ? (
		<p class="hero-ctas">
			{ctaHref && ctaLabel && (
				<a class="btn-3d hero-cta" href={ctaHref}>{ctaLabel}</a>
			)}
			{cta2Href && cta2Label && (
				<a class="btn-3d-secondary hero-cta" href={cta2Href}>{cta2Label}</a>
			)}
		</p>
	) : null}
	<slot />
</div>

<style>
	.hero {
		padding: 2.5rem 0 1.5rem;
		max-width: 44rem;
	}
	.hero-badge {
		display: inline-block;
		font-size: 0.85rem;
		font-weight: 700;
		padding: 0.35rem 0.9rem;
		border-radius: 999px;
		border: 3px solid var(--edge);
		background: var(--surface);
		box-shadow: 3px 3px 0 var(--hard);
	}
	.hero-sub {
		font-size: 1.25rem;
		line-height: 1.65;
		max-width: 40rem;
	}
	.hero-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.hero-cta {
		display: inline-block;
		text-decoration: none;
		font-size: 1.15rem;
	}
</style>
