---
import BgField from "../components/BgField.svelte";
import Board from "../components/Board.astro";
import Footer from "../components/Footer.astro";
import HeaderBar from "../components/HeaderBar.astro";
import PageHero from "../components/PageHero.astro";
import StepCard from "../components/StepCard.astro";
import Study from "../components/Study.svelte";
import "../styles/tokens.css";
---
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Estudio de recuerdo con contraseña desechable. Solo se guarda una huella hash." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Estudio — phrasecraft</title>
	</head>
	<body>
		<BgField client:idle />
		<a class="skip" href="#contenido">Saltar al contenido</a>
		<header>
			<HeaderBar current="/estudio" ctaHref="/" ctaLabel="Crear contraseña" />
			<PageHero
				badge="Voluntario · sin datos personales"
				title="Estudio de recuerdo"
				sub="Ayúdanos a medir si las escenas se recuerdan a 24 h y 7 días, con una contraseña desechable."
			/>
		</header>
		<main id="contenido">
			<section aria-labelledby="pasos">
				<h2 id="pasos">Cómo participar</h2>
				<ol class="steps">
					<StepCard n="1" title="Consiente" text="Lee el consentimiento y genera tu desechable. Nunca uses tu contraseña real." />
					<StepCard n="2" title="Practica" text="Completa las 5 etapas como siempre, con calma." />
					<StepCard n="3" title="Vuelve" text="A las 24 h y 7 días, haz la prueba de recuerdo y envíanos el resultado." />
				</ol>
			</section>
			<Board title="Tablero de estudio" id="estudio" pill="desechable">
				<Study client:load />
			</Board>
		</main>
		<Footer />
	</body>
</html>
