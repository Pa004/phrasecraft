---
import BgField from "../components/BgField.svelte";
import Board from "../components/Board.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import PracticeStandalone from "../components/PracticeStandalone.svelte";
import "../styles/tokens.css";
---
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Practica tu escena en 5 etapas. Todo en tu navegador, nada se guarda." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Practicar — phrasecraft</title>
	</head>
	<body>
		<BgField client:idle />
		<header>
			<PageHero
				badge="5 etapas · todo en memoria"
				title="Practicar"
				sub="Mira, completa, ordena, recuerda y escríbela sin pistas. Nada de lo que escribas sale de tu navegador."
			/>
			<nav class="main-nav" aria-label="Principal">
				<a class="nav-chip" href="/">Generar</a>
				<a class="nav-chip" href="/seguridad">Seguridad</a>
				<a class="nav-chip" href="/estudio">Estudio</a>
			</nav>
		</header>
		<main>
			<Board title="Tablero de práctica" id="practicar">
				<PracticeStandalone client:load />
			</Board>
		</main>
		<Footer />
	</body>
</html>
