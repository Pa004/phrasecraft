---
import BgField from "../components/BgField.svelte";
import Board from "../components/Board.astro";
import FeatureBento from "../components/FeatureBento.astro";
import Footer from "../components/Footer.astro";
import Generator from "../components/Generator.svelte";
import HeaderBar from "../components/HeaderBar.astro";
import PageHero from "../components/PageHero.astro";
import StatBadge from "../components/StatBadge.astro";
import StepCard from "../components/StepCard.astro";
import "../styles/tokens.css";
---
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="phrasecraft: genera una contraseña maestra memorable con una escena visual. Privado, offline, sin cuentas." />
		<meta property="og:title" content="phrasecraft — una escena, una contraseña maestra" />
		<meta property="og:description" content="Generador privado de contraseñas memorables. Todo ocurre en tu navegador." />
		<meta property="og:image" content="https://phrasecraft.pages.dev/og-demo.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<title>phrasecraft — una escena, una contraseña maestra</title>
	</head>
	<body>
		<BgField client:load />
		<a class="skip" href="#contenido">Saltar al contenido</a>
		<header>
			<HeaderBar
				current="/"
				links={[
					{ href: "#como", label: "Cómo funciona" },
					{ href: "#confia", label: "Confianza" },
				]}
				ctaHref="#generar"
				ctaLabel="Crear contraseña"
			/>
			<PageHero
				badge="100% local · nada sale de tu navegador"
				title="Contraseñas que sí recuerdas y nadie adivina."
				marks={["sí recuerdas"]}
				sub="Palabras cotidianas en español unidas en una escena absurda. Más largas, más fuertes y mucho más fáciles de recordar que un código críptico."
				ctaHref="#generar"
				ctaLabel="Crear contraseña"
				cta2Href="#como"
				cta2Label="Ver cómo funciona"
			>
				<ul class="stats" slot="stats" aria-label="Datos clave">
					<StatBadge value="72 bits" label="ENTROPÍA REAL" />
					<StatBadge value="501 palabras" label="LISTA EN ESPAÑOL" />
					<StatBadge value="0 servidores" label="TODO LOCAL" />
				</ul>
			</PageHero>
		</header>
		<main id="contenido">
			<Board title="Tablero de escena" id="generar" pill="501 palabras">
				<Generator client:load />
			</Board>
			<section aria-labelledby="como">
				<h2 id="como">Cómo funciona</h2>
				<ol class="steps">
					<StepCard n="1" title="Genera" text="Un clic crea palabras al azar unidas por una frase absurda y una escena numerada." />
					<StepCard n="2" title="Practica" text="5 etapas guiadas en minutos, todo en tu navegador y sin guardar nada." />
					<StepCard n="3" title="Recuerda" text="Una sola contraseña maestra para lo importante; repásala a 1, 3 y 7 días." />
				</ol>
			</section>
			<section aria-labelledby="confia">
				<h2 id="confia">Por qué confiar</h2>
				<ul class="bento">
					<FeatureBento title="Privacidad real" text="Al pulsar Generar no sale ninguna petición de red: un único sprite idéntico para todos, precacheado." featured />
					<FeatureBento title="Seguridad honesta" text="Kerckhoffs: el atacante conoce el método y la lista. La fuerza viene solo de la aleatoriedad." />
					<FeatureBento title="Memoria guiada" text="Escena + frase + repaso espaciado: tres anclas en vez de una lista de palabras." />
					<FeatureBento title="Abierto y offline" text="Código abierto, PWA instalable y usable sin conexión. Sin cuentas ni rastreo." span />
				</ul>
			</section>
			<section aria-labelledby="uso">
				<h2 id="uso">Úsala bien</h2>
				<ul>
					<li>Úsala para tu contraseña maestra. Para el resto de tus cuentas, usa un gestor de contraseñas.</li>
					<li>Esta escena <strong>es</strong> tu contraseña: no la captures ni la compartas.</li>
				</ul>
			</section>
		</main>
		<Footer />
		<script src="../scripts/board-tilt.ts"></script>
	</body>
</html>
