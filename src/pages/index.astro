---
import BgField from "../components/BgField.svelte";
import Board from "../components/Board.astro";
import Footer from "../components/Footer.astro";
import Generator from "../components/Generator.svelte";
import NavFab from "../components/NavFab.astro";
import PageHero from "../components/PageHero.astro";
import StepCard from "../components/StepCard.astro";
import "../styles/tokens.css";
---
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="phrasecraft: genera una contraseña maestra memorable con una escena visual. Privado, offline, sin cuentas." />
		<meta property="og:title" content="phrasecraft — una escena, una contraseña maestra" />
		<meta property="og:description" content="Generador privado de contraseñas memorables. Todo ocurre en tu navegador." />
		<meta property="og:image" content="https://phrasecraft.pages.dev/og-demo.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<title>phrasecraft — una escena, una contraseña maestra</title>
	</head>
	<body>
	<BgField client:load />
	<a class="skip" href="#contenido">Saltar al contenido</a>
	<NavFab
		current="/"
		sections={[
			{ href: "#como", label: "Cómo funciona", desc: "Genera, practica y recuerda en 3 pasos" },
		]}
	/>
	<header>
		<PageHero
			badge="100% local · nada sale de tu navegador"
			badgeRight="501 palabras"
			title="Contraseñas que sólo recuerdas y nadie adivina."
			marks={["sólo recuerdas"]}
			sub="Palabras cotidianas en español unidas en una escena absurda. Más largas, más fuertes y mucho más fáciles de recordar que un código críptico."
			ctaHref="#generar"
			ctaLabel="Crear contraseña"
			cta2Href="#como"
			cta2Label="Ver cómo funciona"
		/>
	</header>
		<main id="contenido">
			<p class="aviso-maestra" role="note">
				<strong>Úsala para tu contraseña maestra.</strong> Para el resto de tus cuentas, usa un
				gestor de contraseñas.
			</p>
			<Board title="Tablero de escena" id="generar" pill="501 palabras">
				<Generator client:load />
			</Board>
			<section aria-labelledby="como">
				<h2 id="como">Cómo funciona</h2>
				<ol class="steps">
					<StepCard n="1" title="Genera" text="Un clic crea palabras al azar unidas por una frase absurda y una escena numerada." />
					<StepCard n="2" title="Practica" text="5 etapas guiadas en minutos, todo en tu navegador y sin guardar nada." />
					<StepCard n="3" title="Recuerda" text="Una sola contraseña maestra para lo importante; repásala a 1, 3 y 7 días." />
				</ol>
			</section>
			<p class="tira-confianza">
				Código abierto · sin cuentas ni rastreo. <a href="/seguridad">Por qué confiar</a>
			</p>
		</main>
		<Footer />	</body>
</html>

<style>
	.aviso-maestra {
		border: 3px solid var(--edge);
		border-radius: 16px;
		background: var(--accent-soft);
		box-shadow: 4px 4px 0 var(--hard);
		padding: 12px 16px;
		margin: 0 0 1rem;
		font-size: 0.95rem;
	}
	.aviso-maestra strong {
		font-family: var(--font-display);
	}
	.tira-confianza {
		text-align: center;
		font-size: 0.92rem;
		margin: 1.5rem 0 0;
	}
	.tira-confianza a {
		font-weight: 700;
	}
</style>
