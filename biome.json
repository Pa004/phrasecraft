{
	"$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
	"files": {
		"ignore": [
			"src/data/**",
			"public/**",
			"src/styles/panda/**",
			"**/*.snap",
			"package-lock.json"
		]
	},
	"formatter": { "enabled": true, "indentStyle": "tab" },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": { "noNonNullAssertion": "off" }
		}
	},
	"javascript": { "formatter": { "quoteStyle": "double" } }
}
